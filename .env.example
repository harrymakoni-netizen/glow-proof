# GlowProof credentials
# Copy to .env and fill in. .env is gitignored - never commit it.

# --- 1. Perfect Corp (BLOCKING) -------------------------------------------
# https://yce.perfectcorp.com/api-console/  -> API Keys
# Redeem hackathon units: https://yce.perfectcorp.com/api-console/en/redeem-code/
PERFECTCORP_BASE_URL=https://yce-api-01.makeupar.com
# V2: sent as "Authorization: Bearer <key>"
PERFECTCORP_API_KEY=
# Only if your console shows these instead (V1 auth exchange):
PERFECTCORP_CLIENT_ID=
PERFECTCORP_CLIENT_SECRET=

# --- 2. Anthropic (BLOCKING) ----------------------------------------------
# https://console.anthropic.com/settings/keys  - needs billing enabled.
# NOTE: your Claude Code subscription does NOT provide this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- 2b. Google Gemini (alternative to Anthropic) --------------------------
# https://aistudio.google.com/apikey  - free tier, no card required.
# Free limits: 2.5-pro 100/day, 2.5-flash 250/day, 2.5-flash-lite 1000/day.
# If ANTHROPIC_API_KEY is also set, Anthropic wins.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- 3. SerpApi (not blocking) --------------------------------------------
# https://serpapi.com/manage-api-key  - free tier = 100 searches/mo
SERPAPI_API_KEY=

# --- 4. Xano (not blocking - app runs in-memory without it) ---------------
# Backs session persistence (app/xano.py): a `scans` table, one row per scan,
# analysis + routine JSON. See README.md "Xano - what it's actually for" for
# the exact table setup. Without these two, sessions live only in memory for
# the life of the process, same as before this was added.
# Signup: https://go.xano.co/devpost-challenge
# Coupon: M_Xano_PER_100_2608_1_DevpostHackathon
# e.g. https://x123-abcd-1234.n7.xano.io
XANO_INSTANCE_BASE_URL=
# /api:xxxxxxxx - from the scans table's auto-generated API group
XANO_API_GROUP_BASE=
# Only needed if you turn on auth for those endpoints. Account settings -> CLI + MCP.
XANO_PERSONAL_ACCESS_TOKEN=
